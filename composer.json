{
    "name": "horde/spellchecker",
    "description": "Spellchecking library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_SpellChecker",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Ralf Lang",
            "email": "ralf.lang@ralf-lang.de",
            "role": "maintainer"
        },
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        },
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "aspell",
        "spelling"
    ],
    "time": "2026-04-17",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/util": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {},
    "suggest": {},
    "autoload": {
        "psr-0": {
            "Horde_SpellChecker": "lib/"
        },
        "psr-4": {
            "Horde\\SpellChecker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\SpellChecker\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}